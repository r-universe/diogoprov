	path = crywolf
	url = https://github.com/diogoprov/crywolf
	branch = main
[submodule "sheepdog"]
	path = sheepdog
	url = https://github.com/diogoprov/sheepdog
	branch = main
[submodule "treeshapesim"]
	path = treeshapesim
	url = https://github.com/diogoprov/treeshapesim
